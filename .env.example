# ADSO runtime configuration
# Never commit real secrets. Configure these in the deployment provider.

# Database
# Local development currently uses SQLite.
DATABASE_URL="file:./dev.db"
# Production requires a persistent database; do not use a deployment-local SQLite file.
# The Prisma schema currently targets SQLite, so production DB migration must be completed
# before claiming production persistence.

# NextAuth
# In production set this to the canonical HTTPS application URL.
# On Vercel, NEXTAUTH_URL may be derived from VERCEL_URL during platform configuration,
# but setting the canonical URL explicitly is preferred.
NEXTAUTH_URL="http://localhost:3000"
# Generate a new long random secret for each environment.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# AI provider
ZAI_API_KEY=""

# Optional observability
DD_API_KEY=""
DD_APP_KEY=""

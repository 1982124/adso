# ADSO environment template
# Never commit real production credentials.

# Production: managed PostgreSQL (Neon recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth production
NEXTAUTH_URL="https://your-production-domain.example"
NEXTAUTH_SECRET="generate-a-random-secret-of-at-least-32-characters"

# AI provider
ZAI_API_KEY=""

# Official authority information sync (use only authoritative sources)
ADSO_OFFICIAL_FEEDS_JSON='[]'
ADSO_CRON_SECRET="generate-a-random-secret-of-at-least-32-characters"

# Optional observability
DD_API_KEY=""
DD_APP_KEY=""

# Payment provider secrets are configured only in the provider-specific
# Vercel Production environment. Do not put merchant credentials here.

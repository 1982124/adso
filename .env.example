# ADSO environment template
# Never commit real production credentials.

# Production: managed PostgreSQL (Neon recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# NextAuth production
NEXTAUTH_URL="https://your-production-domain.example"
NEXTAUTH_SECRET="generate-a-random-secret-of-at-least-32-characters"

# AI providers — configure real credentials only in the deployment secret store.
OPENAI_API_KEY=""
AI_GATEWAY_API_KEY=""
ADSO_AI_MODEL=""
ZAI_API_KEY=""

# Personal ADSO vault — server-side only; never expose these to the browser.
ADSO_VAULT_PASSWORD_HASH="pbkdf2$..."
ADSO_VAULT_SESSION_SECRET="generate-a-random-secret-of-at-least-32-characters"

# Official authority information sync. Use only authoritative sources.
ADSO_OFFICIAL_FEEDS_JSON='[]'
ADSO_CRON_SECRET="generate-a-random-secret-of-at-least-32-characters"

# Optional observability
DD_API_KEY=""
DD_APP_KEY=""

# Modèle uniquement : copier vers .env sur le VPS.
# Ne jamais committer le vrai fichier .env ni transmettre ses secrets.
# OmniRoute v3.8.52 — préproduction isolée.

OMNIROUTE_IMAGE_TAG=3.8.52
OMNIROUTE_DOMAIN=omniroute-preprod.example.com

# Ports internes documentés. Aucun de ces ports n'est publié sur l'hôte.
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132

# Valeur de sécurité officielle ; aucun port applicatif n'est publié.
APP_BIND_HOST=127.0.0.1
REQUIRE_API_KEY=true
OMNIROUTE_MEMORY_MB=2048

# AUTH_COOKIE_SECURE=true et ALLOW_API_KEY_REVEAL=false sont forcés
# dans le Compose. CORS_ALLOWED_ORIGINS est limité au domaine ci-dessus.

# Après copie sur le VPS, générer une clé distincte pour chiffrer SQLite :
#   openssl rand -hex 32
# Puis décommenter et coller le résultat ici. Conserver cette clé hors VPS
# dans un gestionnaire de secrets/sauvegarde séparée : sa perte rend la DB illisible.
# STORAGE_ENCRYPTION_KEY=

# Nécessaire uniquement si le pont WebSocket Codex externe est utilisé.
# Pour ce cas, générer avec : openssl rand -base64 32
# OMNIROUTE_WS_BRIDGE_SECRET=

# INITIAL_PASSWORD est facultatif : laisser absent pour utiliser l'onboarding.
# Ne jamais utiliser un mot de passe partagé ou prévisible.
# INITIAL_PASSWORD=

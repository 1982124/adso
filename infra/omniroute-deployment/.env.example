# Fichier modèle : copier vers .env sur le VPS uniquement.
# Ne jamais committer le vrai fichier .env ni transmettre ses secrets.
# OmniRoute v3.8.52 — variables du modèle self-host officiel.

OMNIROUTE_IMAGE_TAG=3.8.52
OMNIROUTE_DOMAIN=omniroute-preprod.example.com

# Ports par défaut documentés (dashboard + proxy /v1, API interne, WebSocket).
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132

# Valeur de sécurité par défaut officielle. Aucun port applicatif n'est publié
# sur l'hôte dans notre Compose : seul Caddy accède au réseau Docker privé.
APP_BIND_HOST=127.0.0.1
REQUIRE_API_KEY=true

# Mot de passe initial facultatif. Si absent, créer le mot de passe dans
# l'assistant d'onboarding puis utiliser le jeton bootstrap affiché dans les logs.
# INITIAL_PASSWORD=

# Plafond mémoire V8 documenté pour un usage solo / agents de code.
OMNIROUTE_MEMORY_MB=2048

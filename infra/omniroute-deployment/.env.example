# Copy to .env on the VPS only. Never commit the real .env.
# Pin to an exact published stable image tag after checking the official release list.
OMNIROUTE_IMAGE_TAG=REPLACE_WITH_EXACT_STABLE_VERSION
OMNIROUTE_DOMAIN=omniroute-preprod.example.com

# Generate every secret independently on the server (e.g. openssl rand -hex 32).
# Do not reuse ADSO, GitHub, Vercel, database, or provider credentials.
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET
API_KEY_SECRET=REPLACE_WITH_DIFFERENT_UNIQUE_RANDOM_SECRET
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_UNIQUE_RANDOM_SECRET
STORAGE_ENCRYPTION_KEY_VERSION=v1
OMNIROUTE_WS_BRIDGE_SECRET=REPLACE_WITH_DIFFERENT_UNIQUE_RANDOM_SECRET
INITIAL_PASSWORD=REPLACE_WITH_UNIQUE_LONG_RANDOM_PASSWORD

# The compose file enforces API-key authentication and secure cookies.
REQUIRE_API_KEY=true
AUTH_COOKIE_SECURE=true
NODE_ENV=production
OMNIROUTE_MEMORY_MB=2048
